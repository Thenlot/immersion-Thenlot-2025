/* ==========================================================================
   KROJANTY — IHM (GTK4)
   Feuille "diapo" compatible GTK CSS (sans variables ni gradients lourds)
   ========================================================================== */

/* --- Plateau --- */
.board { background: #ffffff; }

/* --- Case de base (bouton) --- */
button {
  font-size: 22px;
  font-weight: 700;
  border-radius: 0;
  background: #ffffff;
  border: 1px solid #000000;  /* traits fins noirs */
  box-shadow: none;
  color: #000000;
}

/* --- Diagonale jaune (repère visuel léger) --- */
button.diag-yellow { background: #fff9e4; }

/* --- Zones translucides (aires de déploiement) --- */
button.zone-blue { background: rgba(163,208,255,0.35); }
button.zone-red  { background: rgba(255,177,177,0.35); }

/* --- Cités (coins) : simple et robuste --- */
button.city-blue { border-color: #2b7de9; }
button.city-red  { border-color: #e92b2b; }

/* --- Pièces (couleur des glyphes) --- */
button.blue { color: #1e64ff; }
button.red  { color: #e23636; }
button.king    { /* léger relief possible au besoin */ }
button.soldier { opacity: 0.98; }

/* --- Sélection --- */
button.selected {
  outline: 3px solid #222222;
  outline-offset: -3px;
}

/* --- Coordonnées A–I / 1–9 --- */
.coord {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  font-size: 13px;
  color: #8892a6;
  font-weight: 600;
  padding: 2px 0;
}

/* ========================================================================== */
/*      OCCUPATION (avec pièce) et CONTRÔLE (case vide) — versions GTK         */
/* ========================================================================== */
button.occup-blue { background: #3b82f6; color: #ffffff; }
button.occup-red  { background: #ef4444; color: #ffffff; }

button.ctrl-blue { background: rgba(56,189,248,0.18); }
button.ctrl-red  { background: rgba(248,113,113,0.18); }

/* ========================================================================== */
/*                         OVERLAY DE VICTOIRE                                 */
/* ========================================================================== */
.victory-overlay { background: rgba(10,12,16,0.55); }

.victory-banner {
  padding: 24px 28px;
  border-radius: 18px;
  background: #2b3560;
  border: 1px solid rgba(255,255,255,0.08);
}

.victory-text {
  font-size: 32px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.5px;
}

.replay-button {
  font-weight: 700;
  padding: 10px 14px;
  border-radius: 12px;
  background: #3b82f6;
  color: #ffffff;
  border: none;
}
.replay-button:hover { background: #2563eb; }

/* ========================================================================== */
/*                                  SCORES                                     */
/* ========================================================================== */
.score-blue { color: #2563eb; font-weight: 800; letter-spacing: 0.2px; }
.score-red  { color: #dc2626; font-weight: 800; letter-spacing: 0.2px; }
.turns-left { color: #4b5563; font-weight: 700; }

/* ========================================================================== */
/*                            HIGHLIGHTS PLATEAU                               */
/* ========================================================================== */
.cell {
  transition: background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}

.move-hint {
  background-color: rgba(88,156,255,0.14);
  box-shadow: 0 0 0 2px rgba(88,156,255,0.55) inset;
  transform: scale(1.02);
}
.move-hint:hover {
  background-color: rgba(88,156,255,0.22);
  box-shadow: 0 0 0 2px rgba(88,156,255,0.75) inset;
  transform: scale(1.035);
}

/* ========================================================================== */
/*                           PANNEAU D'INFORMATIONS                            */
/* ========================================================================== */
/* Colonne (scroll) */
.info-panel {
  background: #f7f8fb;                 /* léger contraste sur fond blanc */
  border-left: 1px solid rgba(0,0,0,0.08);
}

/* Cartes : on “aplatit” les GtkFrame et on dessine sur leur border-node */
frame.panel-frame {
  background: none;
  border: none;
  padding: 0;
}
frame.panel-frame > border {
  background: #ffffff;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 14px;
  padding: 12px;
  box-shadow: 0 6px 18px rgba(0,0,0,0.06);
}

/* Titre de carte (label titre de GtkFrame) */
frame.panel-frame > label {
  color: #6b7280;
  font-weight: 700;
  letter-spacing: .2px;
  padding: 2px 2px 8px 2px;
}

/* Espacements entre cartes */
.info-panel .panel-frame { margin: 5px 5px; }

/* Badge identité */
.badge {
  background: #f2f6ff;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 999px;
  padding: 8px 12px;
  font-weight: 800;
  letter-spacing: .3px;
  color: #111827;
  }
.badge-blue {
  color: #1d4ed8;
  border-color: rgba(29,78,216,0.25);
  box-shadow: inset 0 0 0 1px rgba(29,78,216,0.15);
}
.badge-red {
  color: #b91c1c;
  border-color: rgba(185,28,28,0.25);
  box-shadow: inset 0 0 0 1px rgba(185,28,28,0.15);
}

/* Compteur de tours */
.counter {
  font-family: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
  font-size: 15px;
  background: #f7fafc;
  border: 1px dashed rgba(0,0,0,0.14);
  border-radius: 10px;
  padding: 8px 12px;
  color: #111827;
  letter-spacing: .5px;
  }

/* État du tour */
.turn-status {
  background: #f9fafb;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 10px;
  padding: 10px 12px;
  line-height: 1.35;
  color: #0f172a;
}
.turn-status.state-ok {
  border-color: rgba(34,197,94,0.35);
  box-shadow: inset 0 0 0 1px rgba(34,197,94,0.18);
  color: #16a34a;
}
.turn-status.state-wait {
  border-color: rgba(245,158,11,0.35);
  box-shadow: inset 0 0 0 1px rgba(245,158,11,0.18);
  color: #b45309;
}

/* Bouton Rejouer (panneau) */
.replay-btn {
  background: #3b82f6;
  color: #ffffff;
  border: none;
  border-radius: 12px;
  padding: 10px 14px;
  font-weight: 800;
  letter-spacing: .2px;
  min-height: 38px;
}
.replay-btn:hover { background: #2563eb; }
.replay-btn:active { transform: translateY(1px); }
.replay-btn:disabled {
  background: #64748b;
  color: #e2e8f0;
  opacity: .9;
}

/* Statut “Joueurs prêts : 1/2” */
.replay-status {
  color: #6b7280;
  margin-top: 6px;
  font-size: 12.5px;
  }

/* Petit statut réseau dans le header */
.status { color: #6b7280; font-size: 12.5px; }

/* ========================================================================== */
/*                    (Option) Styles légers pour ton ancien bloc              */
/* ========================================================================== */
.info-title  { font-size: 18px; font-weight: 800; margin-bottom: 8px; }
.info-label  { font-size: 14px; margin: 8px 0; padding: 4px 0; color: #111827; }
.info-current{
  font-size: 16px; font-weight: 700; margin: 12px 0; padding: 8px;
  background: rgba(0,100,200,0.08);
  border-radius: 8px;
  border-left: 4px solid #0064c8;
}
.info-ready { font-size: 14px; color: #ff6600; font-weight: 700; margin: 8px 0; }
