#
# @file Makefile
# @brief Allow's to build, make the test coverage, make the documentation \
#        and remove files generated by those commands
# @author baptiste.garnier@uha.fr
#
APP_NAME := krojanty-ihm
SRC_DIR  := src
BIN_DIR  := build
TEST_DIR := tests
TEST_AUTO_DIR := $(TEST_DIR)/autogen
NUM_PORT := 5555 #pas sûr je sais mais faut bien mettre un truc
ADDR_IP  := 127.0.0.1# de même
LCOV_DIR := $(TEST_AUTO_DIR)/lcov# dossier pour gcov, lcov
DOC_DIR := documentation
GENHTML_DIR := $(DOC_DIR)/rapport_de_couverture-$(shell date +"%d_%m:%Hh%Mm%S")

SRC  := $(wildcard $(SRC_DIR)/*.c)
HEAD := $(wildcard $(SRC_DIR)/*.h)
BIN  := $(BIN_DIR)/$(APP_NAME)
TEST_BIN := $(TEST_AUTO_DIR)/game
TESTS := $(TEST_DIR)/*.c

# Ajout du répertoire include pour les headers
CFLAGS  := -Wall -Wextra `pkg-config --cflags gtk4` -O3 
LDFLAGS := `pkg-config --libs gtk4` -lpthread
TESTFLAGS := -fprofile-arcs -ftest-coverage -O0 -lgcov -g -DTEST

.PHONY: all run clean dirs tests

all: dirs $(BIN)

dirs:
	@mkdir -p $(BIN_DIR)

# Compilation avec fichiers source spécifiques
$(BIN): $(SRC)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
	ln -sf $(BIN) game
	@echo "OK -> game"

clean:
	rm -rf $(BIN_DIR)
	rm -f game

# Tests avec les mêmes fichiers source
tests : $(SRC) $(TESTS) # les deux sinon gcc ne trouve pas les fonctions à tester
	mkdir -p $(TEST_AUTO_DIR)
	$(CC) $(CFLAGS) $(TESTFLAGS) -o $(TEST_BIN) $^ $(LDFLAGS)
	@echo "Compilé avec les tests"
	@echo "Exécution du binaire"
	$(TEST_BIN)
	@echo "Tous les tests ont été exécutés"
	@mkdir -p $(LCOV_DIR)
	lcov -d $(TEST_AUTO_DIR) -c -o $(LCOV_DIR)/rapport.info
	genhtml -o "$(GENHTML_DIR)" -t "Full rapport du projet" $(LCOV_DIR)/rapport.info
	rm -r $(DOC_DIR)/rapport_de_couverture || true #pour pas que le make ne s'arrête s'il n'y avait pas de dossier précédemment
	cp -fr $(GENHTML_DIR) $(DOC_DIR)/rapport_de_couverture
	@echo "Le rapport est dans $(GENHTML_DIR)/index.html, ou dans la copie $(DOC_DIR)/rapport_de_couverture qui est mise à jour dynamiquement à chaque make tests."

clean_tests:
	rm -rf $(TEST_AUTO_DIR)
	rm -rf $(DOC_DIR)/rapport_de_couverture-*

docs:
	cp -r $(SRC_DIR)/* $(DOC_DIR)/
	cd $(DOC_DIR); doxygen Doxyfile
	rm $(DOC_DIR)/*.c
	rm $(DOC_DIR)/*.h

clean_docs:
	rm -rf $(DOC_DIR)/html
	rm -rf $(DOC_DIR)/latex

help:
	@echo "Cibles disponibles:"
	@echo "  all          - Compile l'application"
	@echo "  tests        - Lance les tests avec couverture"
	@echo "  clean        - Nettoie les fichiers compilés"
	@echo "  clean_test   - Nettoie les fichiers de test"
	@echo "  docs         - Génère la documentation"
